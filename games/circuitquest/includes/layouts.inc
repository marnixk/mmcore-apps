    case 0  ' MODE 19 1366x768
      lay.mode = 19 : lay.W = 1366 : lay.H = 768 : lay.sc = 2 : lay.res$ = "1366x768"
      lay.ts = 64 : lay.vw = 1110 : lay.vh = 768 : lay.px = 1110 : lay.aw = 683 : lay.ah = 384
      lay.mx = 231 : lay.my = 220 : lay.mstep = 22 : lay.sx = 151 : lay.sy = 105 : lay.sstep = 20
    case 1  ' MODE 20 683x384
      lay.mode = 20 : lay.W = 683 : lay.H = 384 : lay.sc = 1 : lay.res$ = "683x384"
      lay.ts = 32 : lay.vw = 555 : lay.vh = 384 : lay.px = 555 : lay.aw = 683 : lay.ah = 384
      lay.mx = 231 : lay.my = 220 : lay.mstep = 22 : lay.sx = 151 : lay.sy = 105 : lay.sstep = 20
