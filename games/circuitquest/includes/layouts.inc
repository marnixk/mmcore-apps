      lay.mode = 11 : lay.W = 1280 : lay.H = 720 : lay.sc = 2 : lay.res$ = "1280x720"
      lay.ts = 64 : lay.vw = 1024 : lay.vh = 720 : lay.px = 1024 : lay.aw = 640 : lay.ah = 360
