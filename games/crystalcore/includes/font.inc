' font.inc - pixel fonts blitted from the UI block on PG_UI (generated by
' art/gen_game_assets.py). All coordinates are UI ART units (x scr.sc = px).
'  small: 9 x 9 cells (glyph + shadow) drawn 8 apart; 8 colour styles (F_* in
'         layouts.inc) of two rows each (FS_N glyphs per row)
'  big:   gold glyphs with a dark rim, 18 x 18 cells drawn 16 apart
'  huge:  gold digits, 27 x 27 cells drawn 24 apart (moves left)

' draw s$ at art x, y in style st on the current write page
sub txt(s$, x, y, st)
  local i, k, s, u$, n, cw, dx, sy0
  s = scr.sc
  cw = 9 * s
  u$ = ucase$(s$)
  n = len(u$)
  sy0 = (FS_Y + 18 * st) * s
  for i = 1 to n
    k = instr(SMALL$, mid$(u$, i, 1)) - 1
    if k < 0 then k = instr(SMALL$, "?") - 1
    if k > 0 then
      dx = (x + (i - 1) * 8) * s
      blit (k mod FS_N) * cw, sy0 + (k \ FS_N) * cw, dx, y * s, cw, cw, PG_UI, 4
    end if
  next i
end sub

function txtW(s$)
  txtW = len(s$) * 8
end function

sub txtC(s$, cx, y, st)
  txt s$, cx - txtW(s$) \ 2, y, st
end sub

sub txtR(s$, rx, y, st)
  txt s$, rx - txtW(s$), y, st
end sub

' big gold text from art x (left edge)
sub big(s$, x, y)
  local i, k, s, u$, n, cw, sy0
  s = scr.sc
  cw = 18 * s
  u$ = ucase$(s$)
  n = len(u$)
  sy0 = BG_Y * s
  for i = 1 to n
    k = instr(BIG$, mid$(u$, i, 1)) - 1
    if k > 0 then
      blit (k mod BG_N) * cw, sy0 + (k \ BG_N) * cw, (x + (i - 1) * 16) * s, y * s, cw, cw, PG_UI, 4
    end if
  next i
end sub

sub bigC(s$, cx, y)
  big s$, cx - len(s$) * 8, y
end sub

sub bigR(s$, rx, y)
  big s$, rx - len(s$) * 16, y
end sub

' huge gold digits, centred on art x cx
sub hugeC(s$, cx, y)
  local i, k, s, x0
  s = scr.sc
  x0 = cx - len(s$) * 12
  for i = 1 to len(s$)
    k = asc(mid$(s$, i, 1)) - 48
    if k >= 0 and k <= 9 then
      blit k * 27 * s, HG_Y * s, (x0 + (i - 1) * 24) * s, y * s, 27 * s, 27 * s, PG_UI, 4
    end if
  next i
end sub
