' Per level: name$, colours in play, moves on EASY NORMAL HARD, score for 2 and 3 stars, goal count,
' then 3 goals (type 1 collect / 2 frost / 3 boulder / 4 chain, colour, count), then 9 rows of 9 cells:
' . off, o gem, 1 / 2 frost under a gem, b / B boulder (1 / 2 hits), c chained gem
const LV_N = 30
dim string lv.name$(LV_N - 1) length 16, lv.cells$(LV_N - 1) length 81
dim lv.nc(LV_N - 1), lv.mv(LV_N - 1, 2), lv.s2(LV_N - 1), lv.s3(LV_N - 1), lv.ng(LV_N - 1)
dim lv.gt(LV_N - 1, 2), lv.gc(LV_N - 1, 2), lv.gn(LV_N - 1, 2)

sub lv.loadAll()
  local k, j, r$
  restore levelData
  for k = 0 to LV_N - 1
    read lv.name$(k), lv.nc(k), lv.mv(k, 0), lv.mv(k, 1), lv.mv(k, 2), lv.s2(k), lv.s3(k), lv.ng(k)
    for j = 0 to 2
      read lv.gt(k, j), lv.gc(k, j), lv.gn(k, j)
    next j
    lv.cells$(k) = ""
    for j = 0 to 8
      read r$
      lv.cells$(k) = lv.cells$(k) + r$
    next j
  next k
end sub

