' font.inc - pixel fonts blitted from the UI block on PG_SHK (generated by
' art/gen_game_assets.py). All coordinates are UI units (x scr.sc = px).
'  small: 9 x 9 cells (glyph + shadow) drawn 8 apart; F_* styles (layouts.inc)
'         of two rows each (FS_N glyphs per row)
'  big:   gold glyphs with a dark rim, 18 x 18 cells drawn 16 apart
dim integer fn_i, fn_k, fn_s, fn_cw, fn_sx0, fn_sy0
dim string fn_u$

' draw s$ at UI x, y in style st on the current write page
sub txt(s$, x, y, st)
  fn_s = scr.sc
  fn_cw = 9 * fn_s
  fn_u$ = ucase$(s$)
  fn_sy0 = lay.uiy + (FS_Y + 18 * st) * fn_s
  for fn_i = 1 to len(fn_u$)
    fn_k = instr(SMALL$, mid$(fn_u$, fn_i, 1)) - 1
    if fn_k < 0 then fn_k = instr(SMALL$, "?") - 1
    if fn_k > 0 then
      blit (fn_k mod FS_N) * fn_cw, fn_sy0 + (fn_k \ FS_N) * fn_cw, (x + (fn_i - 1) * 8) * fn_s, y * fn_s, fn_cw, fn_cw, PG_SHK, 4
    end if
  next fn_i
end sub

function txtW(s$)
  txtW = len(s$) * 8
end function

sub txtC(s$, cx, y, st)
  txt s$, cx - txtW(s$) \ 2, y, st
end sub

sub txtR(s$, rx, y, st)
  txt s$, rx - txtW(s$), y, st
end sub

' big gold text from UI x (left edge)
sub big(s$, x, y)
  fn_s = scr.sc
  fn_cw = 18 * fn_s
  fn_u$ = ucase$(s$)
  fn_sy0 = lay.uiy + BG_Y * fn_s
  for fn_i = 1 to len(fn_u$)
    fn_k = instr(BIG$, mid$(fn_u$, fn_i, 1)) - 1
    if fn_k > 0 then
      blit (fn_k mod BG_N) * fn_cw, fn_sy0 + (fn_k \ BG_N) * fn_cw, (x + (fn_i - 1) * 16) * fn_s, y * fn_s, fn_cw, fn_cw, PG_SHK, 4
    end if
  next fn_i
end sub

sub bigC(s$, cx, y)
  big s$, cx - len(s$) * 8, y
end sub
